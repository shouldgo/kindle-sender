# Instapaper Full API credentials
# Register an "Owner Only" app at https://www.instapaper.com/main/request_oauth_consumer_token
INSTAPAPER_CONSUMER_KEY=
INSTAPAPER_CONSUMER_SECRET=
INSTAPAPER_USERNAME=you@example.com
INSTAPAPER_PASSWORD=

# Kindle delivery
# Add the email address you send FROM in Mail.app to:
# amazon.com/myk → Preferences → Personal Document Settings → Approved email list
KINDLE_EMAIL=your-kindle@kindle.com

# Default article count suggested in the interactive prompt (can be changed per run)
ARTICLES_PER_SEND=10

# Pin Mail.app to send from this account — must match an account in Mail.app AND be on
# Amazon's approved senders list at amazon.com/myk → Personal Document Settings.
# Leave blank to let Mail.app pick (risky if you have multiple accounts configured).
MAIL_FROM=
